{
  "name": "authorship-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Confidential registry of vetted reports about undisclosed AI-generated authorship, searchable by journal editors. Monorepo: one image per folder under apps/.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "npm run migrate -w apps/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8",
    "esbuild": "^0.28",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
